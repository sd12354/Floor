# Copy this file to apps/api/.env. Never commit the copy.
#
#   cp apps/api/.env.example apps/api/.env
#
# Everything above the "Real eBay" line is a working local mock setup.
# Leave it like this to run Floor with no eBay account and no money spent.
# `pnpm dev` and "Start Floor.command" load this file from apps/api.

# mock = fake catalog and fake orders. real = live eBay (and optional AliExpress).
FLOOR_MODE=mock

# development for `pnpm dev`. The Docker image sets production itself.
NODE_ENV=development

# Where the API listens. The dev dashboard is http://127.0.0.1:5173 and proxies /api here.
HOST=127.0.0.1
PORT=4000

# SQLite file, relative to apps/api when you use pnpm dev.
# Docker Compose replaces this with file:/data/floor.db on the floor-data volume.
DATABASE_URL=file:./dev.db

# The origin you type in the browser. Dev is the Vite app. Production is the public https URL.
WEB_ORIGIN=http://127.0.0.1:5173
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Leave blank in dev. Set to 1 only for a private http server. A public site uses https and leaves this blank.
FLOOR_ALLOW_HTTP=
# Set to 1 when nginx, Caddy, or another proxy terminates TLS in front of Floor.
TRUST_PROXY=

# Leave blank for `pnpm dev` (Vite serves the dashboard).
# Production / Docker sets this to the built apps/web/dist directory.
WEB_DIST=

# Optional. info is the default. Also: debug, warn, error.
LOG_LEVEL=info

# ---- Real eBay (leave commented until you have a keyset) ----
# Flip the mode, then fill every line you uncomment. Sandbox first.
# FLOOR_MODE=real
# EBAY_ENV=sandbox
#
# From developer.ebay.com → your keyset. Sandbox App ID / Cert ID, not Production, until you switch EBAY_ENV.
# EBAY_CLIENT_ID=YourName-Floor-SBX-0123456789-abcdef12
# EBAY_CLIENT_SECRET=SBX-0123456789ab-cdef-0123-4567-89ab-cdef
# The RuName whose accepted URL is http://127.0.0.1:4000/api/v1/account/ebay/callback
# EBAY_RU_NAME=Your_Name-YourName-Floor-SBX
#
# Required before Connect eBay. Generate your own. Do not reuse this sample.
#   openssl rand -base64 32
# FLOOR_SECRET_KEY=k7Jw9m2Qv1N8pL4sR0tY6uI3oP5aSdFgHjKlZxCvBnM=
#
# Optional. "Set up my eBay account" in Settings prints the real values to paste here.
# EBAY_FULFILLMENT_POLICY_ID=340987654321
# EBAY_PAYMENT_POLICY_ID=340987654322
# EBAY_RETURN_POLICY_ID=340987654323
# EBAY_MERCHANT_LOCATION_KEY=floor-default
# EBAY_DEFAULT_CATEGORY_ID=9355
#
# Optional static sandbox user token, instead of Connect eBay.
# EBAY_USER_TOKEN=v^1.1#i^1#...
#
# Required only when EBAY_ENV=production. Token is 32–80 letters, numbers, _ or -.
# The endpoint is the public URL of Floor's deletion route, exactly as registered with eBay.
# EBAY_ENV=production
# EBAY_DELETION_TOKEN=replace-with-32-to-80-chars-from-the-ebay-portal
# EBAY_DELETION_ENDPOINT=https://floor.example.com/api/v1/webhooks/ebay/account-deletion
# WEB_ORIGIN=https://floor.example.com
# CORS_ORIGINS=https://floor.example.com
#
# Optional shared secret for callers of POST /api/v1/webhooks/ebay (header X-Floor-Webhook-Secret).
# FLOOR_WEBHOOK_SECRET=generate-a-long-random-string

# ---- Optional suppliers (real mode only; leave blank) ----
# AliExpress Open Platform app. The access token is one you obtain yourself.
# ALIEXPRESS_APP_KEY=123456
# ALIEXPRESS_APP_SECRET=your-aliexpress-app-secret
# ALIEXPRESS_ACCESS_TOKEN=your-seller-access-token
# CJ_API_KEY=
# SPOCKET_API_KEY=

# ---- Knobs you can leave unset ----
# MOCK_TRACKING_DELAY_MS=30000
# MOCK_DELIVERY_DELAY_MS=60000
# SYNC_INTERVAL_MS=300000
# SCHEDULER_TICK_MS=10000
# SCHEDULER_DISABLED=1
# EBAY_ORDER_POLL_MS=60000
