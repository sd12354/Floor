# Copy to apps/api/.env. Never commit the copy.
# Development can omit this file and stay in mock mode on http://127.0.0.1:4000.

# mock (default) or real
FLOOR_MODE=mock
NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# Absolute path in production. Docker compose sets file:/data/floor.db.
DATABASE_URL=file:./dev.db

# Public origin of the dashboard. Required when NODE_ENV=production.
WEB_ORIGIN=http://localhost:5173
# Comma-separated. In production, defaults to WEB_ORIGIN when unset.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to 1 only for a private http deploy. Public sites use https and leave this unset.
FLOOR_ALLOW_HTTP=
# Set to 1 behind a reverse proxy so client IPs and https are read from X-Forwarded-*.
TRUST_PROXY=

# Directory of the built dashboard (pnpm --filter @floor/web build). Unset in `pnpm dev`.
WEB_DIST=

# Required in real mode. 32 bytes: openssl rand -base64 32
FLOOR_SECRET_KEY=
# Optional shared secret for POST /webhooks/ebay (header X-Floor-Webhook-Secret).
FLOOR_WEBHOOK_SECRET=

EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_MERCHANT_LOCATION_KEY=
EBAY_DEFAULT_CATEGORY_ID=
# Required when EBAY_ENV=production (eBay marketplace account deletion).
EBAY_DELETION_TOKEN=
EBAY_DELETION_ENDPOINT=

# Optional supplier connectors.
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_ACCESS_TOKEN=
CJ_API_KEY=
SPOCKET_API_KEY=
