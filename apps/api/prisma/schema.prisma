// Floor data model. SQLite in dev via driver adapter; types kept Postgres-compatible
// (swap `provider = "postgresql"` and the adapter, no model changes needed).

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "sqlite"
}

model Account {
  id                      String   @id
  name                    String
  ebayConnected           Boolean  @default(false)
  ebayUsername            String?
  pricingRule             Json
  fees                    Json
  dailySpendCapCents      Int      @default(50000)
  smallLossToleranceCents Int      @default(500)
  handlingTimeDays        Int      @default(3)
  newSeller               Boolean  @default(false)
  createdAt               DateTime @default(now())

  supplierConnections SupplierConnection[]
  listings            Listing[]
  orders              Order[]
  ledger              LedgerEntry[]
  events              Event[]
  messages            Message[]
}

model SupplierConnection {
  id        String   @id
  accountId String
  supplier  String
  status    String
  label     String
  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, supplier])
}

model Product {
  id               String   @id
  supplier         String
  supplierSku      String
  title            String
  description      String
  images           Json
  costCents        Int
  shippingCents    Int
  stock            Int
  warehouseCountry String
  handlingDays     Int      @default(2)
  brand            String?
  categoryHint     String?
  updatedAt        DateTime @updatedAt

  listings Listing[]

  @@unique([supplier, supplierSku])
}

model Listing {
  id                 String    @id
  accountId          String
  productId          String
  ebayItemId         String?
  title              String
  description        String    @default("")
  priceCents         Int
  floorPriceCents    Int       @default(0)
  buyerShippingCents Int       @default(0)
  quantity           Int       @default(1)
  status             String
  pauseReason        String?
  projectedMarginPct Float
  lastSyncAt         DateTime?
  createdAt          DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  orders  Order[]
  events  Event[]

  @@index([accountId, status])
}

model Order {
  id                    String    @id
  accountId             String
  listingId             String
  ebayOrderId           String    @unique
  buyerName             String
  shipTo                Json
  salePriceCents        Int
  buyerShippingCents    Int
  status                String
  supplierOrderId       String?
  supplierCostCents     Int?
  supplierShippingCents Int?
  ebayFeesCents         Int?
  trackingNumber        String?
  carrier               String?
  ladderDecision        Json?
  holdDeadline          DateTime?
  payoutExpectedAt      DateTime?
  paidOutAt             DateTime?
  deliveredAt           DateTime?
  netProfitCents        Int?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  account  Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  listing  Listing       @relation(fields: [listingId], references: [id])
  ledger   LedgerEntry[]
  events   Event[]
  messages Message[]

  @@index([accountId, status])
  @@index([accountId, createdAt])
}

model LedgerEntry {
  id          String   @id
  accountId   String
  orderId     String?
  kind        String
  amountCents Int
  at          DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id])

  @@index([accountId, at])
}

model Event {
  id        String   @id
  accountId String
  orderId   String?
  listingId String?
  type      String
  payload   Json
  at        DateTime @default(now())

  account Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  order   Order?   @relation(fields: [orderId], references: [id])
  listing Listing? @relation(fields: [listingId], references: [id])

  @@index([accountId, at])
}

model BlockedBrand {
  id      String   @id
  pattern String   @unique
  source  String
  at      DateTime @default(now())
}

model Message {
  id             String   @id
  accountId      String
  orderId        String
  direction      String
  kind           String
  body           String
  suggestedReply String?
  answered       Boolean  @default(false)
  at             DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([accountId, at])
}

// Seller login. Floor is single-seller: the first account created owns the instance.
model User {
  id           String   @id
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  sessions Session[]
}

// `id` is the SHA-256 of the bearer token; the raw token is shown to the client once and never stored.
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
