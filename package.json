{
  "name": "floor",
  "private": true,
  "version": "0.1.0",
  "description": "Floor \u2014 autonomous eBay dropshipping platform. Lists, syncs, buys after the buyer pays, never below the margin floor.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "postinstall": "pnpm --filter @floor/core build",
    "dev": "pnpm --filter @floor/core build && pnpm -r --parallel --filter ./apps/api --filter ./apps/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm --filter @floor/core build && pnpm -r typecheck",
    "lint": "pnpm -r lint"
  }
}
